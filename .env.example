# Copy file này thành .env và điền giá trị (chỉ chạy local; trên GitHub dùng Secrets)

# Gmail gửi thư (bắt buộc)
GMAIL_USER=hainguyenck@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=hainguyenck@gmail.com
EMAIL_FROM_NAME=ZCode Trend Bot

# LLM API (bắt buộc) — mọi nhà cung cấp tương thích OpenAI đều dùng được
# Z.ai (GLM):  LLM_BASE_URL=https://api.z.ai/api/paas/v4  ,  LLM_MODEL=glm-4.6
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1     ,  LLM_MODEL=gpt-4o-mini
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai , LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6
